# Test Mode Configuration for E2E Testing - MANAGER ROLE
# This file is used when running: npm run dev -- --mode test.manager

# Enable test mode - bypasses MSAL authentication
VITE_TEST_MODE=true

# Test user role: Manager (has access to dashboard, approval queue, admin)
VITE_TEST_USER_ROLE=manager

# Azure AD Configuration (not used in test mode, but required for type checking)
VITE_CLIENT_ID=test-client-id
VITE_TENANT_ID=test-tenant-id

# SharePoint Configuration (not used in test mode - mock data is used)
VITE_SHAREPOINT_SITE_URL=https://test.sharepoint.com/sites/TestSite
VITE_LIST_NAME=DWxServiceRequests
VITE_DOCUMENT_LIBRARY=DWxSupportingDocuments

# Calendar (not used in test mode)
VITE_DEMO_CALENDAR_EMAIL=test-calendar@example.com

# Power Automate (not used in test mode)
VITE_POWER_AUTOMATE_URL=

# Manager emails for notifications (not used in test mode)
VITE_MANAGER_EMAILS=test.manager@example.com

# Environment
VITE_ENV=test
