    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.6.0",
    "use-debounce": "^10.1.0",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
