{
  "name": "dwx-traffic-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "DWx Traffic Manager - Intelligent pre-sales coordination and service booking app for Microsoft Teams",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:test:manager": "vite --mode test.manager",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build --mode test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "test": "echo \"Tests not configured yet\" && exit 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "teams",
    "microsoft",
    "service-booking",
    "pre-sales",
    "digital-workplace",
    "traffic-manager"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@azure/msal-react": "^2.2.0",
    "@fluentui/react-components": "^9.72.9",
    "@fluentui/react-datepicker-compat": "^0.6.21",
    "@fluentui/react-icons": "^2.0.316",
    "@fluentui/react-timepicker-compat": "^0.4.27",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.10.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/teams-js": "^2.48.0",
    "axios": "^1.13.2",
    "date-fns": "^3.6.0",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.1.0",
